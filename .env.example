# cp .env.example .env 후 값을 채운다. .env 는 커밋하지 않는다.

APP_ENV=local
# 쉼표로 구분한 프론트 주소
CORS_ORIGINS=http://localhost:3000
# 초대 링크 앞부분 (invite.url = FRONTEND_BASE_URL/m/회의코드). 서버에서는 https://kaltoe.app
FRONTEND_BASE_URL=http://localhost:3000

# PostgreSQL. 로컬은 README "DB" 의 docker run 명령으로 띄운다
DATABASE_URL=postgresql+asyncpg://kaltoe:kaltoe@localhost:5432/kaltoe

# 참가자 토큰(JWT) 서명 키. 서버에서는 길고 무작위인 값을 넣는다 (예: python -c "import secrets; print(secrets.token_urlsafe(48))")
# 로컬(APP_ENV=local)에서 비워 두면 켤 때마다 임시 키를 만든다(다시 시작하면 기존 토큰 무효). 그 밖의 환경에서 비우면 서버가 뜨지 않는다
JWT_SECRET=

# CLOVA Speech 장문 인식 (회의 후 화자 분리) — 네이버 클라우드 CLOVA Speech 빌더 > 연동
CLOVA_LONG_INVOKE_URL=
CLOVA_LONG_SECRET=

# 리턴제로 (회의 중 실시간 STT) — developers.rtzr.ai > 내 애플리케이션
RTZR_CLIENT_ID=
RTZR_CLIENT_SECRET=

# 녹음 합본 m4a 를 올릴 S3 버킷 (recordings/{meetingId}/merged.m4a, 14일 뒤 자동 삭제)
# 액세스 키는 두지 않는다. 서버에서는 EC2 인스턴스 역할로 인증한다
S3_BUCKET=kaltoe-recordings
AWS_REGION=ap-northeast-2
# 회의 중 기기별 WAV · 소리 구간 json 을 쌓는 디렉터리 (서버에서는 호스트 볼륨 경로)
RECORDINGS_DIR=./data/recordings

# OpenAI — 사담 판정 · 요약 (gpt-6-luna)
OPENAI_API_KEY=
# 사담 판정 주기(초). 5~15 사이, 기본 5 (PoC 2 최종값). 범위 밖이면 서버가 뜨지 않는다
OFFTOPIC_INTERVAL_SECONDS=5

# CLOVA 결과 콜백 (INT-01). 비밀키는 HMAC 서명 검증용
CLOVA_CALLBACK_SECRET=
CLOVA_CALLBACK_URL=https://api.wacaw.shop/api/v1/internal/clova/callback
