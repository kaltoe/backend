# cp .env.example .env 후 값을 채운다. .env 는 커밋하지 않는다.

APP_ENV=local
# 쉼표로 구분한 프론트 주소
CORS_ORIGINS=http://localhost:3000

# PostgreSQL. 로컬은 README "DB" 의 docker run 명령으로 띄운다
DATABASE_URL=postgresql+asyncpg://kaltoe:kaltoe@localhost:5432/kaltoe

# 참가자 토큰(JWT) 서명 키. 서버에서는 길고 무작위인 값을 넣는다 (예: python -c "import secrets; print(secrets.token_urlsafe(48))")
# 비워 두면 서버가 켜질 때마다 임시 키를 만들어, 다시 시작하면 기존 토큰이 모두 무효가 된다
JWT_SECRET=

# CLOVA Speech 장문 인식 (회의 후 화자 분리) — 네이버 클라우드 CLOVA Speech 빌더 > 연동
CLOVA_LONG_INVOKE_URL=
CLOVA_LONG_SECRET=

# 리턴제로 (회의 중 실시간 STT) — developers.rtzr.ai > 내 애플리케이션
RTZR_CLIENT_ID=
RTZR_CLIENT_SECRET=
